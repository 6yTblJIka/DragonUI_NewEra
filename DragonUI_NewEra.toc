# --- Guild (modern Communities-style guild window; downport of NewEra/Guild) ---
# Load order: Assets (BLPs + atlas rects) -> Window (shell + mode switching + the Roster-only left
# GuildColumn) -> data layers (Roster/Info/Chat) -> Tabard (the GuildColumn's crest badge) -> Open
# (route ToggleGuildFrame / native GuildFrame to NE_GuildFrame).
modules\guild\Assets.lua
modules\guild\Window.lua
modules\guild\Roster.lua
modules\guild\Info.lua
modules\guild\Chat.lua
modules\guild\Tabard.lua
modules\guild\Open.lua

# --- Social (modern friends window; downport of NewEra/Social) ---
# Load order: Assets (portrait BLP) -> Window (shell + tabs + ToggleFriendsFrame redirect) -> the
# per-tab list files. The Guild tab opens the Guild window above. Chat (channels) + Raid have no
# NewEra counterpart to port — they're built natively on the classic channel/raid APIs.
modules\social\Assets.lua
modules\social\Window.lua
modules\social\Friends.lua
modules\social\Who.lua
modules\social\Channels.lua
modules\social\Raid.lua

# --- LFG (unified retail-style Group Finder over the 3.3.5a Dungeon Finder + Raid Browser) ---
# Load order: Assets (BLPs + atlas rects) -> Window (shell + bluemenu rail + Dungeons/Raids
# category buttons + animated eye) -> Roles (shared role-row factory) -> Dungeons (LFD queue
# pane) -> Raids (LFR queue/browse pane) -> Open (route ToggleLFDParentFrame /
# ToggleLFRParentFrame to NE_GroupFinderFrame). The native hidden LFD/LFR frames stay loaded as
# the state machine; these panes are a modern view over the same shared FrameXML lists.
# NOTE: loads after guild (Textures/Guild ships the bluemenu rail sheets we reuse).
modules\lfg\Assets.lua
modules\lfg\Window.lua
modules\lfg\Roles.lua
modules\lfg\Dungeons.lua
modules\lfg\Raids.lua
modules\lfg\Open.lua

# --- Encounter Journal / Adventure Guide (downport of NewEra/EncounterJournal) ---
# Classic + TBC + WotLK (bosses/loot only — see DataWotLK.lua header for what's still missing:
# lore, abilities, art, models). Load order: Support (dropdown/tooltip/item-cache shims) ->
# Assets (chrome BLPs + NE.flavor) -> Slices (texcoord table) -> Data (vanilla seed) -> DataTBC
# (appends TBC instances, tier=2) -> DataWotLK (appends WotLK instances, tier=3) -> overlays
# (PortraitOverrides/AbilitiesEra/AbilitiesTBC/LootEra merge into NE.ej.DATA; must follow the
# data they patch) -> ModelCam (generated per-boss cameras) -> EncounterItem (loot row builder)
# -> EncounterPage (encounter view) -> NavBar (breadcrumb + search) -> EncounterJournal (window
# shell + boot).
modules\encounterjournal\Support.lua
modules\encounterjournal\Assets.lua
modules\encounterjournal\Slices.lua
modules\encounterjournal\Data.lua
modules\encounterjournal\DataTBC.lua
modules\encounterjournal\DataWotLK.lua
modules\encounterjournal\PortraitOverrides.lua
modules\encounterjournal\AbilitiesEra.lua
modules\encounterjournal\AbilitiesTBC.lua
modules\encounterjournal\AbilitiesWotLK.lua
modules\encounterjournal\LootEra.lua
modules\encounterjournal\ModelCam.lua
modules\encounterjournal\EncounterItem.lua
modules\encounterjournal\EncounterPage.lua
modules\encounterjournal\NavBar.lua
modules\encounterjournal\EncounterJournal.lua
modules\encounterjournal\MicroButton.lua

# --- Cooldown Manager (downport of NewEra/CooldownViewer) — PHASE 1: Essential + Utility ---
# Retail's Cooldown Manager runs on C_CooldownViewer, which exists on no Classic-family client;
# NewEra rebuilt it as retail's visual model over curated per-class data, and that is what ports.
# Load order: ClassData (pure tables) -> CooldownViewer (core: settings store, spell-list
# resolution) -> ItemMixins (the per-tile mixin) -> Viewers (frames built in Lua, replacing
# CooldownViewer.xml — MaskTexture and GridLayoutFrame are both unavailable here) -> Register
# (movers + options tab, replacing EditModeRegister.lua). See modules/cooldownviewer/PORT_PLAN.md.
modules\cooldownviewer\ClassData.lua
# WotLK seed: additive appends onto the vanilla lists above, plus the whole of Death Knight. Every
# id is generated from this client's own Spell.dbc + SkillLineAbility.dbc, never hand-typed.
# Must load AFTER ClassData (it appends to those tables) and BEFORE the viewer core reads them.
modules\cooldownviewer\CdmSeedWotLK.lua
modules\cooldownviewer\CooldownViewer.lua
modules\cooldownviewer\ItemMixins.lua
modules\cooldownviewer\Viewers.lua
# Phase 3, the aura-driven viewers. AuraItemMixins needs M.CropIcon/M.TooltipSetSpell from
# ItemMixins; BuffViewers needs M.BaseViewerMixin from Viewers — so both load after those two.
modules\cooldownviewer\AuraItemMixins.lua
modules\cooldownviewer\BuffViewers.lua
# Phase 4a: per-cooldown alerts and ready sounds. The ENGINE and its stores only — assignment UI
# belongs to the Phase 4b settings panel. AlertData is generated
# (tools/cdm-spellgen/gen_alertdata.py) and must precede Alerts, which reads it.
modules\cooldownviewer\AlertData.lua
modules\cooldownviewer\SoundAlertData.lua
modules\cooldownviewer\Alerts.lua
# Phase 4b-1: the standalone /cdm settings window (shell). SettingsAssets registers the side-tab
# art and must load before the panel builds tabs from it. Both need core/Tabs.lua and
# core/PanelChrome.lua, which load far earlier.
modules\cooldownviewer\SettingsAssets.lua
modules\cooldownviewer\SettingsPanel.lua
modules\cooldownviewer\Register.lua

